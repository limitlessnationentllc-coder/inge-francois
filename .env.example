# -----------------------------------------------------------------------------
# INGÉ FRANÇOIS — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# -----------------------------------------------------------------------------

# Shopify Storefront API
# ------------------------
# Leave both unset to run the site against the built-in demo catalog
# (src/lib/data/demo-products.ts) — this is the default, out-of-the-box state.
# Once the real INGÉ FRANÇOIS Shopify store exists, create a Storefront API
# access token (Shopify Admin → Settings → Apps and sales channels →
# Develop apps → your app → Storefront API) and set both variables below.
# No code changes are required — src/lib/shopify/index.ts switches to live
# data automatically once these are present.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-token

# Site URL (used for metadata/OG tags)
NEXT_PUBLIC_SITE_URL=https://www.ingefrancois.com

# Concierge request form destination (see src/app/api/concierge/route.ts).
# Point this at whatever handles concierge intake for now (e.g. a Zapier /
# form-relay webhook); swap for a real CRM endpoint later.
CONCIERGE_WEBHOOK_URL=
